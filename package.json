{
  "name": "nasiya-miniapp",
  "version": "1.0.0",
  "private": true,
  "type": "module",
  "description": "Apple mahsulotlarini naqd va nasiyaga sotish: Telegram bot + miniapp + admin panel",
  "scripts": {
    "dev": "concurrently -k -n api,web -c cyan,magenta \"npm:dev:api\" \"npm:dev:web\"",
    "dev:api": "node --disable-warning=ExperimentalWarning --watch-path=server server/index.js",
    "dev:web": "vite",
    "build": "vite build",
    "start": "vite build && node --disable-warning=ExperimentalWarning server/index.js",
    "serve": "node --disable-warning=ExperimentalWarning server/index.js"
  },
  "dependencies": {
    "dotenv": "^16.4.5",
    "exceljs": "^4.4.0",
    "express": "^4.21.2",
    "grammy": "^1.30.0",
    "multer": "^1.4.5-lts.1",
    "node-cron": "^3.0.3",
    "react": "^18.3.1",
    "react-dom": "^18.3.1",
    "react-router-dom": "^6.28.0"
  },
  "devDependencies": {
    "@vitejs/plugin-react": "^4.3.4",
    "concurrently": "^9.1.0",
    "vite": "^5.4.11"
  }
}
