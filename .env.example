# Server porti (npm start / npm run serve)
PORT=3100

# @BotFather'dan olingan token. Bo'sh bo'lsa tizim botsiz ishlaydi (xabarlar konsolga yoziladi)
BOT_TOKEN=

# Miniapp ochiladigan ommaviy HTTPS manzil (masalan ngrok: https://xxxx.ngrok-free.app).
# Telegram miniappni faqat HTTPS orqali ochadi. Lokal brauzerda test uchun shart emas.
PUBLIC_URL=http://localhost:3100

# Admin panel birinchi kirish ma'lumotlari (keyin Sozlamalardan o'zgartiriladi)
ADMIN_LOGIN=admin
ADMIN_PASSWORD=admin123

# Brauzerda (Telegramsiz) miniappni demo-mijoz sifatida ochishga ruxsat. Productionda 0 qiling.
DEV_LOGIN=1

# Birinchi ishga tushishda demo mahsulot/mijoz/shartnomalar qo'shilsinmi
SEED_DEMO=1
